# 생성 산출물 — 용량 크고 결과물이라 백업 제외
output/
*.DS_Store
__pycache__/
*.pyc

# 비밀 — Slack webhook URL
scripts/.slack_webhook

# 비밀 — QuickBooks OAuth 자격증명·토큰
config/qbo_credentials.json
config/qbo_tokens.json

# guide/ 안 — 스토어 상품 export(민감/대용량)·가이드 PDF, github 제외 (폴더 구조만 유지)
guide/*
!guide/.gitkeep

# prose-qa-ko 스킬은 별도 리포에서 심볼릭 링크로 설치한다 (절대경로라 커밋 안 함)
#   /Volumes/External/claude/prose-qa-ko/install.sh <이 프로젝트 경로>
.claude/skills/prose-qa-ko
